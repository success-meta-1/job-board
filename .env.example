# Copy this file to `.env.local` and fill in ONE search provider.
# The provider runs your bookmark queries (e.g. `remote site:greenhouse.io`) against Google.
# Keys stay on the server side of Next.js; they are never sent to the browser.

# Which provider to use: serper | serpapi | google-cse | brave
# If omitted, the first provider with a key is used.
SEARCH_PROVIDER=

# Serper.dev - real Google results, 2,500 free queries. https://serper.dev
SERPER_API_KEY=

# SerpAPI - real Google results, 250 free queries/month. https://serpapi.com
SERPAPI_API_KEY=

# Google Programmable Search (Custom Search JSON API). Closed to new customers;
# only works if you already have a key. Enable "Search the entire web" on the engine.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Brave Search API (independent index, not Google). https://brave.com/search/api
BRAVE_API_KEY=
